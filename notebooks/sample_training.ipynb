    "# loac_slices() 함수 정의\n",
    "import os\n",
    "import pydicom\n",
    "\n",
    "def load_slices(study_id, series_id, base_path=\"rsna_2024_spine/train_images\"):\n",
    "    \"\"\"\n",
    "    주어진 study_id, series_id에 해당하는 DICOM 슬라이스를 불러오고 InstanceNumber 기준으로 정렬\n",
    "    \"\"\"\n",
    "    dcm_path = os.path.join(base_path, str(study_id), str(series_id))\n",
    "    files = os.listdir(dcm_path)\n",
    "\n",
    "    slices = []\n",
    "    for f in files:\n",
    "        if f.endswith(\".dcm\"):\n",
    "            filepath = os.path.join(dcm_path, f)\n",
    "            dcm = pydicom.dcmread(filepath)\n",
    "            slices.append((int(dcm.InstanceNumber), f, dcm))\n",
    "\n",
    "    # InstanceNumber로 정렬\n",
    "    slices.sort(key=lambda x: x[0])\n",
    "\n",
    "    return slices\n"
   ]
  },
