   "source": [
    "# 10개 샘플 자동화\n",
    "results = []\n",
    "\n",
    "for i in range(len(sampled_anchors)):\n",
    "    row = sampled_anchors.iloc[i]\n",
    "    study_id = str(row[\"study_id\"])\n",
    "    series_id = str(row[\"series_id\"])\n",
    "    instance_num = int(row[\"instance_number\"])\n",
    "    \n",
    "    print(f\"\\n📌 [{i+1}/10] study_id={study_id}, series_id={series_id}, instance={instance_num}\")\n",
    "    \n",
    "    try:\n",
    "        # 1. DICOM 불러오기\n",
    "        slices = load_slices(study_id, series_id)\n",
    "        anchor_img, target_img = None, None\n",
    "        for inst, _, dcm in slices:\n",
    "            if inst == instance_num:\n",
    "                anchor_img = dcm.pixel_array\n",
    "            elif inst == instance_num + 1:\n",
    "                target_img = dcm.pixel_array\n",
    "        if anchor_img is None or target_img is None:\n",
    "            print(\"❌ 슬라이스 없음\")\n",
    "            continue\n",
    "\n",
    "        # 2. 라벨 불러오기\n",
    "        anchor_labels = label_df[\n",
    "            (label_df[\"study_id\"] == int(study_id)) &\n",
    "            (label_df[\"series_id\"] == int(series_id)) &\n",
    "            (label_df[\"instance_number\"] == instance_num)\n",
    "        ]\n",
    "        coords = anchor_labels[[\"x\", \"y\"]].to_numpy()\n",
    "        if len(coords) == 0:\n",
    "            print(\"⚠️ 좌표 없음\")\n",
    "            continue\n",
    "\n",
    "        # 3. Hybrid registration 학습\n",
    "        model, flow = train_hybrid_registration(anchor_img, target_img, coords, steps=300, lam=1.0)\n",
    "\n",
    "        # 4. 전파된 좌표 비교\n",
    "        pred_disp = flow_sample(flow, torch.tensor(coords).float().cuda())\n",
    "        pred_coords = coords + pred_disp.cpu().detach().numpy()\n",
    "        l2_errors = np.linalg.norm(pred_coords - coords, axis=1)\n",
    "\n",
    "        results.append({\n",
    "            \"study_id\": study_id,\n",
    "            \"series_id\": series_id,\n",
    "            \"instance\": instance_num,\n",
    "            \"num_labels\": len(coords),\n",
    "            \"mean_L2\": np.mean(l2_errors),\n",
    "            \"max_L2\": np.max(l2_errors)\n",
    "        })\n",
    "\n",
    "        print(f\"✅ 평균 L2 거리: {np.mean(l2_errors):.2f} px\")\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"❌ 오류 발생: {e}\")\n",
    "        continue\n",
    "\n",
    "# 전체 요약\n",
    "import pandas as pd\n",
    "result_df = pd.DataFrame(results)\n",
    "display(result_df)\n",
    "print(f\"\\n📊 전체 평균 L2: {result_df['mean_L2'].mean():.2f} px\")\n"
   ]
  },
