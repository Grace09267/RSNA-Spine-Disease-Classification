  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "783b8aec",
   "metadata": {},
   "outputs": [],
   "source": [
    "# axial은 샘플 10개를 돌리면 오류가 남.\n",
    "# 원인 : permute() 함수는 텐서 차원을 바꿀때 쓰이는데, 1D 텐서(예(N,))에 대해 .permute(1,0)과 같이 2D 형태로 순서를 지정하려다가 생긴오류\n",
    "# sampled = sampled.squeeze().permute(1, 0) 여기서 오류가 남 왜냐하면 sampled.squeeze() 결과가 1D텐서가 되서\n",
    "\n",
    "\n",
    "# 모델정의(예시 : simpleRegNet)\n",
    "# Hybrid CNN Registration for One Pair\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "import numpy as np\n",
    "\n",
    "# 1. 모델\n",
    "class SimpleRegNet(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.encoder = nn.Sequential(\n",
    "            nn.Conv2d(2, 16, 3, padding=1), nn.ReLU(),\n",
    "            nn.Conv2d(16, 32, 3, padding=1), nn.ReLU(),\n",
    "            nn.Conv2d(32, 32, 3, padding=1), nn.ReLU()\n",
    "        )\n",
    "        self.flow_head = nn.Conv2d(32, 2, 3, padding=1)\n",
    "\n",
    "    def forward(self, fixed, moving):\n",
    "        x = torch.cat([fixed, moving], dim=1)\n",
    "        f = self.encoder(x)\n",
    "        flow = self.flow_head(f)\n",
    "        return flow\n",
    "\n",
    "# 2. warping 함수\n",
    "def warp(image, flow):\n",
    "    B, C, H, W = image.shape\n",
    "    grid_y, grid_x = torch.meshgrid(torch.arange(H), torch.arange(W), indexing='ij')\n",
    "    grid = torch.stack((grid_x, grid_y), dim=2).float().to(image.device)\n",
    "    grid = grid.unsqueeze(0).repeat(B, 1, 1, 1)\n",
    "    new_grid = grid + flow.permute(0, 2, 3, 1)\n",
    "    new_grid[..., 0] = 2 * new_grid[..., 0] / (W - 1) - 1\n",
    "    new_grid[..., 1] = 2 * new_grid[..., 1] / (H - 1) - 1\n",
    "    return F.grid_sample(image, new_grid, align_corners=True)\n",
    "\n",
    "# 3. flow로 좌표 이동\n",
    "def flow_sample(flow, coords):\n",
    "    B, C, H, W = flow.shape\n",
    "    coords = coords.clone().float().to(flow.device)  # (N, 2): x, y\n",
    "\n",
    "    # normalize to [-1, 1]\n",
    "    norm_coords = coords.clone()\n",
    "    norm_coords[:, 0] = (norm_coords[:, 0] / (W - 1)) * 2 - 1  # x\n",
    "    norm_coords[:, 1] = (norm_coords[:, 1] / (H - 1)) * 2 - 1  # y\n",
    "\n",
    "    grid = norm_coords.view(1, -1, 1, 2)  # (1, N, 1, 2)\n",
    "    sampled = F.grid_sample(flow, grid, align_corners=True, mode='bilinear')  # (1, 2, N, 1)\n",
    "    sampled = sampled.view(flow.shape[1], -1).T  # (N, 2)\n",
    "    '''\n",
    "    # 수정 : dim이 2D인지 확인하고 permute 적용\n",
    "    if sampled.ndim == 2:\n",
    "        sampled = sampled.permute(1, 0)\n",
    "    else:\n",
    "        print(f\"⚠️ skip: sampled.ndim={sampled.ndim}, shape={sampled.shape}\")\n",
    "        return torch.zeros_like(coords)  # 혹은 적절한 fallback\n",
    "    '''\n",
    "    return sampled\n",
    "\n",
    "# 4. hybrid 학습 루프\n",
    "def train_hybrid_registration(anchor_img, target_img, anchor_coords, steps=300, lam=1.0):\n",
    "    model = SimpleRegNet().cuda()\n",
    "    model.train()\n",
    "    optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)\n",
    "    loss_img = nn.MSELoss()\n",
    "    loss_pts = nn.MSELoss()\n",
    "\n",
    "    def prep(img):\n",
    "        norm = (img - img.min()) / (img.max() - img.min() + 1e-8)\n",
    "        return torch.tensor(norm, dtype=torch.float32).unsqueeze(0).unsqueeze(0).cuda()\n",
    "\n",
    "    fixed = prep(anchor_img)\n",
    "    moving = prep(target_img)\n",
    "\n",
    "    coords = torch.tensor(anchor_coords, dtype=torch.float32).cuda()  # (N, 2)\n",
    "\n",
    "    for step in range(steps):\n",
    "        flow = model(fixed, moving)  # (1, 2, H, W)\n",
    "        warped = warp(moving, flow)  # (1, 1, H, W)\n",
    "\n",
    "        # 1. 이미지 정합 loss\n",
    "        li = loss_img(warped, fixed)\n",
    "\n",
    "        # 2. 전파 좌표\n",
    "        pred_disp = flow_sample(flow, coords)  # (N, 2)\n",
    "        pred_coords = coords + pred_disp\n",
    "        lp = loss_pts(pred_coords, coords)\n",
    "\n",
    "        # 3. 최종 loss\n",
    "        loss = li + lam * lp\n",
    "\n",
    "        optimizer.zero_grad()\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "        if step % 50 == 0:\n",
    "            print(f\"[Step {step}] ImageLoss={li.item():.4f} / CoordLoss={lp.item():.4f}\")\n",
    "\n",
    "    return model, flow.detach()"
   ]
  },
