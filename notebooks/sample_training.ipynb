    "# GT 좌표 불러오기기\n",
    "import pandas as pd\n",
    "\n",
    "# label_df를 한 번만 불러오는 경우\n",
    "label_path = \"rsna_2024_spine/train_label_coordinates.csv\"\n",
    "label_df = pd.read_csv(label_path)\n",
    "\n",
    "# anchor 좌표 필터링 (study_id=4003253, series_id=702807833, instance=8)\n",
    "anchor_coords_df = label_df[\n",
    "    (label_df[\"study_id\"] == 4003253) &\n",
    "    (label_df[\"series_id\"] == 702807833) &\n",
    "    (label_df[\"instance_number\"] == 8)\n",
    "]\n",
    "\n",
    "print(f\"Anchor 좌표 수: {len(anchor_coords_df)}\")\n",
    "anchor_coords_df[[\"condition\", \"level\", \"x\", \"y\"]]\n"
   ]
