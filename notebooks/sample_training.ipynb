    "# Attention Heatmap 생성 함수(단일 슬라이드 기준)\n",
    "import numpy as np\n",
    "import cv2\n",
    "import torch\n",
    "\n",
    "def generate_heatmap(height, width, points, sigma=10):\n",
    "    \"\"\"\n",
    "    height, width: 이미지 크기\n",
    "    points: [(x1, y1), (x2, y2), ...] 형태의 좌표 리스트\n",
    "    sigma: Gaussian 분포의 표준편차\n",
    "    returns: (H, W) 형태의 heatmap (float32)\n",
    "    \"\"\"\n",
    "    heatmap = np.zeros((height, width), dtype=np.float32)\n",
    "\n",
    "    for (x, y) in points:\n",
    "        if not (0 <= int(x) < width and 0 <= int(y) < height):\n",
    "            continue  # 이미지 범위 밖 좌표 무시\n",
    "\n",
    "        tmp = np.zeros_like(heatmap)\n",
    "        tmp[int(y), int(x)] = 1\n",
    "        tmp = cv2.GaussianBlur(tmp, (0, 0), sigma)\n",
    "        tmp = tmp / tmp.max()\n",
    "        heatmap += tmp\n",
    "\n",
    "    heatmap = np.clip(heatmap, 0, 1)\n",
    "    return heatmap\n"
   ]
  },
