    "                target_img = dcm.pixel_array\n",
    "        if anchor_img is None or target_img is None:\n",
    "            print(\"❌ 슬라이스 없음\")\n",
    "            continue\n",
    "\n",
    "        # 2. 라벨 불러오기\n",
    "        anchor_labels = label_df[\n",
    "            (label_df[\"study_id\"] == int(study_id)) &\n",
    "            (label_df[\"series_id\"] == int(series_id)) &\n",
    "            (label_df[\"instance_number\"] == instance_num)\n",
    "        ]\n",
    "        coords = anchor_labels[[\"x\", \"y\"]].to_numpy()\n",
    "        if len(coords) == 0:\n",
    "            print(\"⚠️ 좌표 없음\")\n",
    "            continue\n",
    "\n",
    "        # 3. Hybrid registration 학습\n",
    "        model, flow = train_hybrid_registration(anchor_img, target_img, coords, steps=300, lam=1.0)\n",
    "\n",
    "        # 4. 전파된 좌표 비교\n",
    "        pred_disp = flow_sample(flow, torch.tensor(coords).float().cuda())\n",
    "        pred_coords = coords + pred_disp.cpu().detach().numpy()\n",
    "        l2_errors = np.linalg.norm(pred_coords - coords, axis=1)\n",
