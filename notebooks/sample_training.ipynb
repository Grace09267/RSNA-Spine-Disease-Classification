    "def compute_cycle_error(model, anchor_tensor, target_tensor, coords):\n",
    "    model.eval()\n",
    "    \n",
    "    # Forward: Anchor → Target\n",
    "    flow_ab = model(anchor_tensor, target_tensor)\n",
    "    disp_ab = flow_sample(flow_ab, coords)\n",
    "    coords_B = coords + disp_ab\n",
    "\n",
    "    # Backward: Target → Anchor\n",
    "    flow_ba = model(target_tensor, anchor_tensor)\n",
    "    disp_ba = flow_sample(flow_ba, coords_B)\n",
    "    coords_A_recon = coords_B + disp_ba\n",
    "\n",
    "    # Cycle error 계산\n",
    "    cycle_error = torch.norm(coords - coords_A_recon, dim=1)\n",
    "    return cycle_error, coords_B, coords_A_recon\n"
   ]
  },
