   "source": [
    "import os\n",
    "import numpy as np\n",
    "import pydicom\n",
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 예시 정보\n",
    "study_id = \"100206310\"\n",
    "series_id = \"1012284084\"\n",
    "slice_idx = 8\n",
    "\n",
    "# 경로 (0-padding 제거)\n",
    "img_path = f\"rsna_2024_spine/train_images/{study_id}/{series_id}/{slice_idx}.dcm\"\n",
    "heatmap_path = f\"heatmaps/{study_id}_{series_id}_{slice_idx}.png\"\n",
    "coord_path = f\"heatmaps/{study_id}_{series_id}_{slice_idx}.npy\"\n",
    "\n",
    "# DICOM 이미지 불러오기\n",
    "if not os.path.exists(img_path):\n",
    "    raise FileNotFoundError(f\"Image not found: {img_path}\")\n",
    "dcm = pydicom.dcmread(img_path)\n",
    "img = dcm.pixel_array.astype(np.float32)\n",
    "img = cv2.resize(img, (512, 512))\n",
    "img = (img - np.min(img)) / (np.max(img) - np.min(img))  # 정규화\n",
    "\n",
    "# Heatmap\n",
    "if not os.path.exists(heatmap_path):\n",
    "    raise FileNotFoundError(f\"Heatmap not found: {heatmap_path}\")\n",
    "heatmap = cv2.imread(heatmap_path, cv2.IMREAD_GRAYSCALE)\n",
    "\n",
    "# 좌표 로딩 및 마스크 생성\n",
    "if not os.path.exists(coord_path):\n",
    "    raise FileNotFoundError(f\"Coord not found: {coord_path}\")\n",
    "coord = np.load(coord_path)  # [x, y]\n",
    "\n",
    "print(coord)\n",
    "print(coord.shape)\n",
    "\n",
    "mask = np.zeros((512, 512), dtype=np.uint8)\n",
    "x, y = int(coord[0]), int(coord[1])\n",
    "cv2.circle(mask, (x, y), radius=10, color=255, thickness=-1)\n",
    "\n",
    "# 시각화\n",
    "fig, axes = plt.subplots(1, 4, figsize=(18, 5))\n",
    "\n",
    "axes[0].imshow(img, cmap='gray')\n",
    "axes[0].set_title(\"DICOM Image\")\n",
    "\n",
    "axes[1].imshow(heatmap, cmap='hot')\n",
    "axes[1].set_title(\"Heatmap\")\n",
    "\n",
    "axes[2].imshow(mask, cmap='gray')\n",
    "axes[2].set_title(\"Pseudo Mask\")\n",
    "\n",
    "axes[3].imshow(img, cmap='gray')\n",
    "axes[3].imshow(mask, alpha=0.4, cmap='Reds')\n",
    "axes[3].set_title(\"Overlay\")\n",
    "\n",
    "for ax in axes:\n",
    "    ax.axis(\"off\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
