    "# 이미지 + 히트맵 결합한 입력 텐서 생성 함수\n",
    "import torch\n",
    "\n",
    "def prepare_input_with_heatmap(img, heatmap):\n",
    "    \"\"\"\n",
    "    img: (H, W) numpy array (원본 grayscale 이미지)\n",
    "    heatmap: (H, W) numpy array (0~1 범위)\n",
    "    returns: torch.tensor of shape (1, 2, H, W) → [image, heatmap] 채널 결합\n",
    "    \"\"\"\n",
    "    # 정규화\n",
    "    img_norm = (img - img.min()) / (img.max() - img.min() + 1e-8)\n",
    "    \n",
    "    img_tensor = torch.tensor(img_norm, dtype=torch.float32).unsqueeze(0)  # (1, H, W)\n",
    "    heatmap_tensor = torch.tensor(heatmap, dtype=torch.float32).unsqueeze(0)  # (1, H, W)\n",
    "\n",
    "    input_tensor = torch.cat([img_tensor, heatmap_tensor], dim=0).unsqueeze(0)  # (1, 2, H, W)\n",
    "    return input_tensor\n"
   ]
