    "# 히트맵이랑 DICOM 이미지 시각적 비교 코드\n",
    "import matplotlib.pyplot as plt\n",
    "import cv2\n",
    "import numpy as np\n",
    "import pydicom\n",
    "import os\n",
    "\n",
    "def overlay_heatmap_on_dicom(study_id, series_id, instance_number, base_path=\"rsna_2024_spine/train_images\", heatmap_dir=\"heatmaps\"):\n",
    "    # 1. DICOM 불러오기\n",
    "    dcm_path = os.path.join(base_path, str(study_id), str(series_id))\n",
    "    files = sorted([f for f in os.listdir(dcm_path) if f.endswith(\".dcm\")])\n",
    "    target_file = None\n",
    "    for f in files:\n",
    "        dcm = pydicom.dcmread(os.path.join(dcm_path, f))\n",
    "        if int(dcm.InstanceNumber) == instance_number:\n",
    "            target_file = os.path.join(dcm_path, f)\n",
    "            break\n",
    "\n",
    "    if target_file is None:\n",
    "        print(\"슬라이스를 찾을 수 없습니다.\")\n",
    "        return\n",
    "\n",
    "    dcm = pydicom.dcmread(target_file)\n",
    "    image = dcm.pixel_array\n",
    "    image = (image - image.min()) / (image.max() - image.min() + 1e-8)  # normalize\n",
    "    image = (image * 255).astype(np.uint8)\n",
    "\n",
    "    # 2. 히트맵 불러오기\n",
    "    heatmap_path = os.path.join(heatmap_dir, f\"{study_id}_{series_id}_{instance_number}.png\")\n",
    "    if not os.path.exists(heatmap_path):\n",
    "        print(\"히트맵 이미지가 없습니다.\")\n",
    "        return\n",
    "    heatmap = cv2.imread(heatmap_path)\n",
    "    heatmap = cv2.resize(heatmap, (image.shape[1], image.shape[0]))\n",
    "\n",
    "    # 3. Overlay 시각화\n",
    "    overlay = cv2.addWeighted(cv2.cvtColor(image, cv2.COLOR_GRAY2BGR), 0.6, heatmap, 0.4, 0)\n",
    "\n",
    "    # 4. 시각화\n",
    "    plt.figure(figsize=(12, 6))\n",
    "    plt.subplot(1, 3, 1)\n",
    "    plt.title(\"Original DICOM\")\n",
    "    plt.imshow(image, cmap=\"gray\")\n",
    "    plt.axis(\"off\")\n",
    "\n",
    "    plt.subplot(1, 3, 2)\n",
    "    plt.title(\"Heatmap Only\")\n",
    "    plt.imshow(heatmap)\n",
    "    plt.axis(\"off\")\n",
    "\n",
    "    plt.subplot(1, 3, 3)\n",
    "    plt.title(\"Overlay\")\n",
    "    plt.imshow(overlay)\n",
    "    plt.axis(\"off\")\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "overlay_heatmap_on_dicom(623720801, 2297434480, 1)\n"
