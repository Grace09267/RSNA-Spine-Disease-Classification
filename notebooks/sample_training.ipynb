    "# 실제 DICOM 존재 확인\n",
    "import os\n",
    "\n",
    "def check_dicom_exists(df, base_path=\"rsna_2024_spine/train_images\"):\n",
    "    exists = []\n",
    "    for _, row in df.iterrows():\n",
    "        path = os.path.join(base_path, str(row[\"study_id\"]), str(row[\"series_id\"]))\n",
    "        if os.path.exists(path):\n",
    "            exists.append(True)\n",
    "        else:\n",
    "            exists.append(False)\n",
    "    return df[exists]\n"
   ]
