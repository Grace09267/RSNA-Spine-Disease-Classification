   "source": [
    "#########################################\n",
    "# 모든 시리즈 멀티로 돌리기\n",
    "\n",
    "import os\n",
    "\n",
    "def extract_valid_anchors(desc_df, label_df, target_series, base_path=\"rsna_2024_spine/train_images\"):\n",
    "    anchors = desc_df[\n",
    "        desc_df[\"series_description\"] == target_series\n",
    "    ].merge(\n",
    "        label_df[[\"study_id\", \"series_id\", \"instance_number\"]].drop_duplicates(),\n",
    "        on=[\"study_id\", \"series_id\"]\n",
    "    )\n",
    "\n",
    "    exists = []\n",
    "    for _, row in anchors.iterrows():\n",
    "        path = os.path.join(base_path, str(row[\"study_id\"]), str(row[\"series_id\"]))\n",
    "        exists.append(os.path.exists(path))\n",
    "\n",
    "    valid_anchors = anchors[exists].reset_index(drop=True)\n",
    "    return valid_anchors\n",
    "\n",
    "\n",
    "def get_pair_images(slices, anchor_instance):\n",
    "    \"\"\"\n",
    "    anchor_instance에 해당하는 슬라이스와, 바로 다음 슬라이스를 반환\n",
    "    \"\"\"\n",
    "    anchor_img, target_img = None, None\n",
    "    for inst_num, _, dcm in slices:\n",
    "        if inst_num == anchor_instance:\n",
    "            anchor_img = dcm.pixel_array\n",
    "        elif inst_num == anchor_instance + 1:\n",
    "            target_img = dcm.pixel_array\n",
    "    if anchor_img is None or target_img is None:\n",
    "        raise ValueError(f\"Anchor({anchor_instance}) or Target({anchor_instance+1}) 이미지 없음\")\n",
    "    return anchor_img.astype(np.float32), target_img.astype(np.float32)\n",
    "\n",
    "import torch\n",
    "\n",
    "def extract_coords(label_df, study_id, series_id, instance_number):\n",
    "    \"\"\"\n",
    "    특정 study/series/instance에 대한 GT 좌표 (x, y)를 numpy 배열로 추출\n",
    "    \"\"\"\n",
    "    df = label_df[\n",
    "        (label_df[\"study_id\"] == int(study_id)) &\n",
    "        (label_df[\"series_id\"] == int(series_id)) &\n",
    "        (label_df[\"instance_number\"] == int(instance_number))\n",
    "    ]\n",
    "\n",
    "    if df.empty:\n",
    "        return torch.zeros((0, 2)), df  # 좌표 없음\n",
    "\n",
    "    coords = df[[\"y\", \"x\"]].values  # y, x 순서로 가져감\n",
    "    coords_tensor = torch.tensor(coords, dtype=torch.float32)  # (N, 2)\n",
    "    return coords_tensor, df\n",
    "\n"
   ]
  },
