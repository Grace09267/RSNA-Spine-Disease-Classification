   "cell_type": "code",
   "execution_count": 17,
   "id": "d2bc8e99",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 전체 슬라이스(1~15)로 registration -> 전파 -> 다시 anchor로 역전파(cycle consistency)\n",
    "# CNN 모델(SimpleRegNet)\n",
    "import torch.nn as nn\n",
    "import torch\n",
    "\n",
    "class SimpleRegNet(nn.Module):\n",
    "    def __init__(self):\n",
    "        super(SimpleRegNet, self).__init__()\n",
    "        self.encoder = nn.Sequential(\n",
    "            nn.Conv2d(2, 32, 3, padding=1), nn.ReLU(),\n",
    "            nn.Conv2d(32, 32, 3, padding=1), nn.ReLU(),\n",
    "            nn.MaxPool2d(2),\n",
    "\n",
    "            nn.Conv2d(32, 64, 3, padding=1), nn.ReLU(),\n",
    "            nn.Conv2d(64, 64, 3, padding=1), nn.ReLU(),\n",
    "            nn.MaxPool2d(2),\n",
    "        )\n",
    "        self.decoder = nn.Sequential(\n",
    "            nn.ConvTranspose2d(64, 32, 4, stride=2, padding=1), nn.ReLU(),\n",
    "            nn.ConvTranspose2d(32, 16, 4, stride=2, padding=1), nn.ReLU(),\n",
    "            nn.Conv2d(16, 2, 3, padding=1)  # 최종 flow 출력 (dx, dy)\n",
    "        )\n",
    "\n",
    "    def forward(self, source, target):\n",
    "        x = torch.cat([source, target], dim=1)  # (B, 2, H, W)\n",
    "        x = self.encoder(x)\n",
    "        flow = self.decoder(x)\n",
    "        return flow  # shape: (B, 2, H, W)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "01a19be4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 좌표 전파용 유틸 함수(flow_sample)\n",
    "import torch.nn.functional as F\n",
    "\n",
    "def flow_sample(flow, coords):\n",
    "    \"\"\"\n",
    "    flow: (1, 2, H, W)\n",
    "    coords: (N, 2) in (x, y) image coordinates\n",
    "    returns: flow vectors at those points\n",
    "    \"\"\"\n",
    "    N = coords.shape[0]\n",
    "    H, W = flow.shape[2], flow.shape[3]\n",
    "    \n",
    "    norm_coords = coords.clone().float()\n",
    "    norm_coords[:, 0] = (norm_coords[:, 0] / (W - 1)) * 2 - 1\n",
    "    norm_coords[:, 1] = (norm_coords[:, 1] / (H - 1)) * 2 - 1\n",
    "    grid = norm_coords.view(1, N, 1, 2)  # (1, N, 1, 2)\n",
    "\n",
    "    sampled = F.grid_sample(flow, grid, align_corners=True, mode='bilinear')  # (1, 2, N, 1)\n",
    "    sampled = sampled.squeeze().permute(1, 0)  # (N, 2)\n",
    "    return sampled\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "5144b25b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. 슬라이스 불러오기\n",
    "slices = load_slices(4003253, 702807833)\n",
    "\n",
    "# 2. anchor 이미지 및 GT 좌표 세팅\n",
    "anchor_instance = 8\n",
    "anchor_img = [img for inst, img in slices if inst == anchor_instance][0]\n",
    "\n",
    "# 3. GT 좌표 텐서화\n",
    "gt_coords = torch.tensor([\n",
    "    [322.831858, 227.964602],\n",
    "    [320.571429, 295.714286],\n",
    "    [323.030303, 371.818182],\n",
    "    [335.292035, 427.327434],\n",
    "    [353.415929, 483.964602]\n",
    "], dtype=torch.float32).cuda()\n",
    "\n",
    "# 4. 모델 및 전처리 함수 세팅\n",
    "model = SimpleRegNet().cuda()\n",
    "model.eval()\n",
    "\n",
    "def prepare_image_tensor(np_image):\n",
    "    norm = (np_image - np_image.min()) / (np_image.max() - np_image.min() + 1e-8)\n",
    "    tensor = torch.tensor(norm, dtype=torch.float32).unsqueeze(0).unsqueeze(0)\n",
    "    return tensor.cuda()\n"
   ]
  },
