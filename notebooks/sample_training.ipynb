   "source": [
    "# anchor와 target 슬라이스 가져오기\n",
    "# study_id, series_id instance_number를 기준으로 achor이미지와 target 이미지(보통 anchor+-1)를 불러오는 함수수\n",
    "import os\n",
    "import pydicom\n",
    "\n",
    "def load_anchor_and_target(study_id, series_id, anchor_instance, offset=1, base_path=\"rsna_2024_spine/train_images\"):\n",
    "    dcm_dir = os.path.join(base_path, str(study_id), str(series_id))\n",
    "    files = sorted([f for f in os.listdir(dcm_dir) if f.endswith(\".dcm\")])\n",
    "    \n",
    "    anchor_img, target_img = None, None\n",
    "    \n",
    "    for f in files:\n",
    "        path = os.path.join(dcm_dir, f)\n",
    "        dcm = pydicom.dcmread(path)\n",
    "        inst = int(dcm.InstanceNumber)\n",
    "        \n",
    "        if inst == anchor_instance:\n",
    "            anchor_img = dcm.pixel_array\n",
    "        elif inst == anchor_instance + offset:\n",
    "            target_img = dcm.pixel_array\n",
    "        \n",
    "        if anchor_img is not None and target_img is not None:\n",
    "            break\n",
    "    \n",
    "    return anchor_img, target_img\n"
   ]
  },
