   "source": [
    "# 양방향 registration\n",
    "# 이미지 → 텐서 변환\n",
    "def prepare_image_tensor(np_img):\n",
    "    norm = (np_img - np_img.min()) / (np_img.max() - np_img.min() + 1e-8)\n",
    "    tensor = torch.tensor(norm, dtype=torch.float32).unsqueeze(0).unsqueeze(0).cuda()\n",
    "    return tensor\n",
    "\n",
    "# 예시 실행\n",
    "anchor_tensor = prepare_image_tensor(anchor_img)\n",
    "target_tensor = prepare_image_tensor(target_img)\n",
    "\n",
    "# 좌표도 tensor로\n",
    "def prepare_coords(coords):\n",
    "    return torch.tensor(coords, dtype=torch.float32).cuda()\n",
    "\n",
    "model = SimpleRegNet().cuda()\n",
    "model.eval()\n",
    "\n",
    "# 전방향 flow 예시\n",
    "flow_ab = model(anchor_tensor, target_tensor)  # anchor → target\n",
    "pred_disp = flow_sample(flow_ab, coords)\n",
    "coords_in_B = coords + pred_disp\n",
    "\n",
    "# 역방향 flow 예시\n",
    "flow_ba = model(target_tensor, anchor_tensor)  # target → anchor\n",
    "pred_back = flow_sample(flow_ba, coords_in_B)\n",
    "coords_back_to_A = coords_in_B + pred_back\n"
   ]
