   "source": [
    "# cycle error 전체 코드(재학습 후 반영도 포함)\n",
    "import torch\n",
    "import pandas as pd\n",
    "import os\n",
    "import torch.nn.functional as F\n",
    "\n",
    "# --- [0] 사전 함수 준비 ---\n",
    "def prepare_image_tensor(np_image):\n",
    "    norm = (np_image - np_image.min()) / (np_image.max() - np_image.min() + 1e-8)\n",
    "    tensor = torch.tensor(norm, dtype=torch.float32).unsqueeze(0).unsqueeze(0)\n",
    "    return tensor.cuda()\n",
    "\n",
    "def flow_sample(flow, coords):\n",
    "    N = coords.shape[0]\n",
    "    H, W = flow.shape[2:]\n",
    "    norm_coords = coords.clone()\n",
    "    norm_coords[:, 0] = (norm_coords[:, 0] / (W - 1)) * 2 - 1\n",
    "    norm_coords[:, 1] = (norm_coords[:, 1] / (H - 1)) * 2 - 1\n",
    "    grid = norm_coords.view(1, N, 1, 2)\n",
    "    sampled = F.grid_sample(flow, grid, align_corners=True, mode='bilinear')\n",
    "    return sampled.squeeze().permute(1, 0)\n",
    "\n",
    "def warp(image, flow):\n",
    "    B, C, H, W = image.shape\n",
    "    grid_x, grid_y = torch.meshgrid(torch.arange(W), torch.arange(H), indexing='xy')\n",
    "    grid = torch.stack((grid_x, grid_y), 2).float().to(image.device)\n",
    "    grid = grid.unsqueeze(0)\n",
    "    grid = grid + flow.permute(0, 2, 3, 1)\n",
    "    grid[..., 0] = (grid[..., 0] / (W - 1)) * 2 - 1\n",
    "    grid[..., 1] = (grid[..., 1] / (H - 1)) * 2 - 1\n",
    "    return F.grid_sample(image, grid, align_corners=True, mode='bilinear')\n",
    "\n",
    "def train_hybrid_registration(anchor_img, target_img, coords, steps=300, lam=1.0):\n",
    "    anchor_tensor = prepare_image_tensor(anchor_img)\n",
    "    target_tensor = prepare_image_tensor(target_img)\n",
    "    coords = coords.detach().cuda()\n",
    "\n",
    "    model = SimpleRegNet().cuda()\n",
    "    model.train()\n",
    "    optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
    "\n",
    "    for step in range(steps):\n",
    "        flow = model(anchor_tensor, target_tensor)\n",
    "        warped = warp(target_tensor, flow)\n",
    "        loss_img = F.mse_loss(warped, anchor_tensor)\n",
    "\n",
    "        disp = flow_sample(flow, coords)\n",
    "        pred_coords = coords + disp\n",
    "        loss_pts = F.mse_loss(pred_coords, coords)\n",
    "\n",
    "        loss = loss_img + lam * loss_pts\n",
    "\n",
    "        optimizer.zero_grad()\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "    return model.eval(), model(anchor_tensor, target_tensor)\n",
    "\n",
    "# --- [1] 설정 및 데이터 ---\n",
    "study_id = 4003253\n",
    "series_id = 702807833\n",
    "anchor_instance = 8\n",
    "base_path = \"rsna_2024_spine/train_images\"\n",
    "\n",
    "# --- [2] 슬라이스 불러오기 ---\n",
    "def load_slices(study_id, series_id, base_path):\n",
    "    path = os.path.join(base_path, str(study_id), str(series_id))\n",
    "    files = sorted(os.listdir(path))\n",
    "    slices = []\n",
    "    for f in files:\n",
    "        if f.endswith(\".dcm\"):\n",
    "            dcm = pydicom.dcmread(os.path.join(path, f))\n",
    "            slices.append((int(dcm.InstanceNumber), dcm.pixel_array))\n",
    "    return slices\n",
    "\n",
    "slices = load_slices(study_id, series_id, base_path)\n",
    "anchor_img = [img for inst, img in slices if inst == anchor_instance][0]\n",
    "anchor_tensor = prepare_image_tensor(anchor_img)\n",
    "\n",
    "# --- [3] GT 좌표 및 메타 정보 ---\n",
    "gt_coords = torch.tensor([\n",
    "    [322.831858, 227.964602],\n",
    "    [320.571429, 295.714286],\n",
    "    [323.030303, 371.818182],\n",
    "    [335.292035, 427.327434],\n",
    "    [353.415929, 483.964602]\n",
    "], dtype=torch.float32).cuda()\n",
    "\n",
    "gt_rows = label_df[\n",
    "    (label_df[\"study_id\"] == study_id) &\n",
    "    (label_df[\"series_id\"] == series_id) &\n",
    "    (label_df[\"instance_number\"] == anchor_instance)\n",
    "]\n",
    "\n",
    "# --- [4] 라벨 전파 (Cycle Error 검증 및 보정 포함) ---\n",
    "model = SimpleRegNet().cuda()\n",
    "model.eval()\n",
    "results_list = []\n",
    "\n",
    "for inst_num, target_img in slices:\n",
    "    if inst_num == anchor_instance:\n",
    "        continue\n",
    "\n",
    "    target_tensor = prepare_image_tensor(target_img)\n",
    "    with torch.no_grad():\n",
    "        flow_ab = model(anchor_tensor, target_tensor)\n",
    "        coords_target = gt_coords + flow_sample(flow_ab, gt_coords)\n",
    "\n",
    "        flow_ba = model(target_tensor, anchor_tensor)\n",
    "        coords_back = coords_target + flow_sample(flow_ba, coords_target)\n",
    "\n",
    "        cycle_error = (coords_back - gt_coords).norm(dim=1).mean().item()\n",
    "\n",
    "    # ⛳ 재학습 기준 초과 시 → 보정\n",
    "    if cycle_error > 0.2:\n",
    "        print(f\"🔁 재학습: Instance {inst_num} (Cycle Error: {cycle_error:.4f})\")\n",
    "        model, flow_ab = train_hybrid_registration(anchor_img, target_img, gt_coords)\n",
    "        coords_target = gt_coords + flow_sample(flow_ab, gt_coords)\n",
    "\n",
    "    for coord, row in zip(coords_target, gt_rows.itertuples()):\n",
    "        x, y = coord.detach().cpu().numpy()\n",
    "        results_list.append({\n",
    "            \"study_id\": study_id,\n",
    "            \"series_id\": series_id,\n",
    "            \"instance_number\": inst_num,\n",
    "            \"level\": row.level,\n",
    "            \"condition\": row.condition,\n",
    "            \"x\": float(x),\n",
    "            \"y\": float(y)\n",
    "        })\n",
    "\n",
    "# --- [5] 저장 ---\n",
    "df = pd.DataFrame(results_list)\n",
    "os.makedirs(\"output\", exist_ok=True)\n",
    "df.to_csv(\"output/propagated_labels_refined.csv\", index=False)\n",
    "print(\"✅ 저장 완료: output/propagated_labels_refined.csv\")\n"
   ]
