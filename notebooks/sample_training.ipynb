    "    anchor_tensor = prepare_image_tensor(anchor_img)\n",
    "    target_tensor = prepare_image_tensor(target_img)\n",
    "\n",
    "    # forward flow\n",
    "    flow_ab = model(anchor_tensor, target_tensor)\n",
    "    coords_in_target = gt_coords + flow_sample(flow_ab, gt_coords)\n",
    "\n",
    "    # backward flow\n",
    "    flow_ba = model(target_tensor, anchor_tensor)\n",
    "    coords_back_to_anchor = coords_in_target + flow_sample(flow_ba, coords_in_target)\n",
    "\n",
    "    # cycle error\n",
    "    cycle_error = (coords_back_to_anchor - gt_coords).norm(dim=1)\n",
    "    mean_error = cycle_error.mean().item()\n",
    "    \n",
    "    cycle_errors[inst_num] = mean_error  # ✅ dict 저장\n",
    "\n",
    "    print(f\"[Instance {inst_num}] 🔁 Cycle Error: {mean_error:.4f} px\")\n"
