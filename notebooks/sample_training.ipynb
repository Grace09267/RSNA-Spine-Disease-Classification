    "'''\n",
    "# 재학습 루트 코드(CNN registration) -> 이 모델을 사용하니 cycle error가 더 나빠짐... 아마 아되는 아이들을 다시 돌리니 더 나빠지는 것 같음.\n",
    "# 하이브리드 registration 학습 함수\n",
    "def train_hybrid_registration(anchor_img, target_img, coords, steps=300, lam=1.0):\n",
    "    anchor_tensor = prepare_image_tensor(anchor_img)\n",
    "    target_tensor = prepare_image_tensor(target_img)\n",
    "\n",
    "    coords = coords.clone().detach().cuda()\n",
    "\n",
    "    model = SimpleRegNet().cuda()\n",
    "    optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
    "\n",
    "    for step in range(steps):\n",
    "        model.train()\n",
    "        flow = model(anchor_tensor, target_tensor)\n",
    "\n",
    "        # 이미지 loss (self-supervised)\n",
    "        warped_target = warp(target_tensor, flow)\n",
    "        loss_img = F.mse_loss(warped_target, anchor_tensor)\n",
    "\n",
    "        # 좌표 loss (GT 존재시)\n",
    "        pred_disp = flow_sample(flow, coords)\n",
    "        pred_coords = coords + pred_disp\n",
    "        loss_pts = F.mse_loss(pred_coords, coords)\n",
    "\n",
    "        loss = loss_img + lam * loss_pts\n",
    "\n",
    "        optimizer.zero_grad()\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "        if step % 50 == 0:\n",
    "            print(f\"[Step {step}] ImageLoss={loss_img.item():.4f} / CoordLoss={loss_pts.item():.4f}\")\n",
    "\n",
    "    return model, flow\n",
    "'''"
