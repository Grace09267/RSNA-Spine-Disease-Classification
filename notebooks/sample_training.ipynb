    "\n",
    "# Step 1. series_description 전체 대상 anchor 후보 수집\n",
    "target_series = [\"Sagittal T2/STIR\", \"Sagittal T1\", \"Axial T2\"]\n",
    "multi_anchors = []\n",
    "\n",
    "for series in target_series:\n",
    "    anchors = extract_valid_anchors(desc_df, label_df, series)\n",
    "    multi_anchors.extend(anchors.to_dict(\"records\"))  # 리스트로 통합\n",
    "\n",
    "\n",
    "# Step 2. 상위 N개 anchor만 선택\n",
    "max_samples = 100\n",
    "anchor_list = multi_anchors[:max_samples]\n",
    "\n",
    "# Step 3. 루프 돌며 hybrid registration 및 전파 정확도 평가\n",
    "results = []\n",
    "\n",
    "for i, anchor in enumerate(anchor_list):\n",
    "    study_id = str(anchor[\"study_id\"])\n",
    "    series_id = str(anchor[\"series_id\"])\n",
    "    inst_num = int(anchor[\"instance_number\"])\n",
    "    \n",
    "    try:\n",
    "        # 1) DICOM load\n",
    "        slices = load_slices(study_id, series_id)\n",
    "        anchor_img, target_img = get_pair_images(slices, inst_num)\n",
    "\n",
    "        # 2) 좌표 로드\n",
    "        coords, meta = extract_coords(label_df, study_id, series_id, inst_num)\n",
    "        if len(coords) < 1:\n",
    "            continue\n",
    "\n",
    "        # 3) registration\n",
    "        model, flow = train_hybrid_registration(anchor_img, target_img, coords, steps=250, lam=1.0)\n",
    "\n",
    "        # 4) 전파 및 평가\n",
    "        pred_disp = flow_sample(flow, coords.to(\"cuda\"))\n",
    "        pred_coords = coords.to(\"cuda\") + pred_disp\n",
    "        l2_errors = torch.norm(pred_coords - coords.to(\"cuda\"), dim=1).cpu().numpy()\n",
    "\n",
    "        results.append({\n",
    "            \"study_id\": study_id,\n",
    "            \"series_id\": series_id,\n",
    "            \"instance\": inst_num,\n",
    "            \"num_labels\": len(coords),\n",
    "            \"mean_L2\": l2_errors.mean(),\n",
    "            \"max_L2\": l2_errors.max()\n",
    "        })\n",
    "\n",
    "        print(f\"✅ [{i+1}/{len(anchor_list)}] {series_id} → 평균 L2: {l2_errors.mean():.4f}\")\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"❌ [{i+1}/{len(anchor_list)}] Error: {e}\")\n",
    "\n",
    "\n",
    "# Step 4. 결과 DataFrame 정리\n",
    "import pandas as pd\n",
    "df_results = pd.DataFrame(results)\n",
    "display(df_results)\n",
    "\n"
   ]
