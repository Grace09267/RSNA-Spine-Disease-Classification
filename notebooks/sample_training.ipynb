    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.metrics import confusion_matrix\n",
    "\n",
    "# 예측 결과와 실제 레이블 (shape: [batch, 25])\n",
    "# 예시: model output after argmax (int)\n",
    "preds = np.load(\"preds.npy\")       # shape: (B, 25)\n",
    "targets = np.load(\"targets.npy\")   # shape: (B, 25)\n",
    "\n",
    "num_slices = preds.shape[1]\n",
    "conf_matrices = []\n",
    "slice_accuracies = []\n",
    "\n",
    "for i in range(num_slices):\n",
    "    cm = confusion_matrix(targets[:, i], preds[:, i], labels=[0, 1, 2])\n",
    "    conf_matrices.append(cm)\n",
    "    acc = np.trace(cm) / np.sum(cm)\n",
    "    slice_accuracies.append(acc)\n",
    "\n",
    "avg_cm = np.mean(conf_matrices, axis=0)\n",
    "\n",
    "# Confusion Matrix 시각화\n",
    "plt.figure(figsize=(6, 5))\n",
    "sns.heatmap(avg_cm, annot=True, fmt=\".1f\", cmap=\"Blues\",\n",
    "            xticklabels=[\"Normal\", \"Moderate\", \"Severe\"],\n",
    "            yticklabels=[\"Normal\", \"Moderate\", \"Severe\"])\n",
    "plt.title(\"Average Confusion Matrix (25 slices)\")\n",
    "plt.xlabel(\"Predicted\")\n",
    "plt.ylabel(\"True\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Slice-wise Accuracy 시각화\n",
    "plt.figure(figsize=(10, 4))\n",
    "plt.plot(slice_accuracies, marker='o')\n",
    "plt.title(\"Slice-wise Accuracy\")\n",
    "plt.xlabel(\"Slice Index\")\n",
    "plt.ylabel(\"Accuracy\")\n",
    "plt.xticks(np.arange(num_slices))\n",
    "plt.ylim(0, 1)\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
