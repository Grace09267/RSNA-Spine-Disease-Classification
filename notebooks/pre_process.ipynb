    "\n",
    "def prepare_image_tensor(np_image, device=\"cuda\"):\n",
    "    \"\"\"\n",
    "    np_image: numpy array (H, W), float32\n",
    "    returns: torch tensor (1, 1, H, W) on GPU\n",
    "    \"\"\"\n",
    "    norm = (np_image - np_image.min()) / (np_image.max() - np_image.min() + 1e-8)\n",
