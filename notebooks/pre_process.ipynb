   "source": [
    "# Mutual Information 계산 코드\n",
    "import SimpleITK as sitk\n",
    "\n",
    "def calculate_mutual_information(img1, img2):\n",
    "    # 둘 다 SimpleITK 이미지로 변환\n",
    "    fixed = sitk.Cast(sitk.GetImageFromArray(img1), sitk.sitkFloat32)\n",
    "    moving = sitk.Cast(sitk.GetImageFromArray(img2), sitk.sitkFloat32)\n",
    "\n",
    "    # Mutual Information 계산 세팅\n",
    "    metric = sitk.MattesMutualInformationImageToImageMetricv4()\n",
    "    metric.SetNumberOfHistogramBins(50)\n",
    "    metric.SetFixedImage(fixed)\n",
    "    metric.SetMovingImage(moving)\n",
    "\n",
    "    # MI 계산\n",
    "    mi_value = metric.GetValue()\n",
    "\n",
    "    return mi_value\n",
    "# Anchor-Target 사이의 Mutual INformation을 계산 할 수 잇음음"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 90,
   "id": "e73daf43",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2단계 : Keypoint Inlier Ratio 계산\n",
    "# Inlier란?\n",
    "# SIFT 특징점 매칭햇을 떄, 진자 잘 매칭된 점(outlier은 튄점)\n",
    "# Inlier ratio = 좋은 매칭 수 / 전체 매칭 수\n",
    "def calculate_inlier_ratio(src_pts, dst_pts, M, threshold=5.0):\n",
    "    \"\"\"\n",
    "    src_pts: (N, 2) np.array (anchor points)\n",
    "    dst_pts: (N, 2) np.array (target points)\n",
    "    M: estimated affine transform\n",
    "    threshold: inlier로 인정할 최대 거리 차이 (픽셀 단위)\n",
    "    \"\"\"\n",
    "    # Source 포인트에 변환 적용\n",
    "    src_pts_homo = np.concatenate([src_pts, np.ones((src_pts.shape[0], 1))], axis=1)  # Nx3\n",
    "    transformed_src_pts = (M @ src_pts_homo.T).T  # Nx2\n",
    "\n",
    "    # 거리 계산\n",
    "    dists = np.linalg.norm(transformed_src_pts - dst_pts, axis=1)\n",
    "\n",
    "    # inlier 개수 세기\n",
    "    inlier_count = np.sum(dists < threshold)\n",
    "    total_count = len(dists)\n",
    "\n",
    "    inlier_ratio = inlier_count / total_count\n",
    "\n",
    "    return inlier_ratio\n"
   ]
  },
