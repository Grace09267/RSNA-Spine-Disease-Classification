   "source": [
    "# flwo magnitude heatmap을 anchor 이미지 위에 반투명하게 겹쳐서 시각화\n",
    "# Flow Magnitude + Anchor Overlay 시각화\n",
    "def visualize_flow_overlay(flow_tensor, anchor_image, alpha=0.5, title=\"Flow Magnitude Overlay\"):\n",
    "    \"\"\"\n",
    "    flow_tensor: (1, 2, H, W)\n",
    "    anchor_image: numpy (H, W), float32\n",
    "    \"\"\"\n",
    "    # 1. flow magnitude 계산\n",
    "    flow_np = flow_tensor.squeeze().detach().cpu().numpy()\n",
    "    u = flow_np[0]\n",
    "    v = flow_np[1]\n",
    "    magnitude = np.sqrt(u**2 + v**2)\n",
    "\n",
    "    # 2. anchor 정규화\n",
    "    anchor_norm = (anchor_image - anchor_image.min()) / (anchor_image.max() - anchor_image.min() + 1e-8)\n",
    "\n",
    "    # 3. heatmap 생성\n",
    "    cmap = plt.get_cmap('jet')\n",
    "    heatmap = cmap(magnitude / magnitude.max())[:, :, :3]  # RGB만 사용 (A 제거)\n",
    "\n",
    "    # 4. 겹쳐서 시각화\n",
    "    overlay = (1 - alpha) * np.repeat(anchor_norm[:, :, np.newaxis], 3, axis=2) + alpha * heatmap\n",
    "\n",
    "    plt.figure(figsize=(6, 6))\n",
    "    plt.imshow(overlay)\n",
    "    plt.title(title)\n",
    "    plt.axis('off')\n",
    "    plt.show()\n",
    "\n",
    "# 사용 예시\n",
    "visualize_flow_overlay(flow, anchor_img_np, alpha=0.5)\n"
   ]
  },
