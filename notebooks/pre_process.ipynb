    "# Affine registration으로 대충 정렬(1단계)\n",
    "# b-spline registration으로 local 보정(2단계)\n",
    "# 최조 transform으로 좌표 이동\n",
    "import SimpleITK as sitk\n",
    "\n",
    "def register_anchor_to_target_bspline(anchor_img, target_img):\n",
    "    # 이미지를 SimpleITK 포맷으로 변환하고 float32로 캐스팅\n",
    "    fixed = sitk.Cast(sitk.GetImageFromArray(anchor_img), sitk.sitkFloat32)\n",
    "    moving = sitk.Cast(sitk.GetImageFromArray(target_img), sitk.sitkFloat32)\n",
    "\n",
    "    # Step 1: Affine registration\n",
    "    affine_reg = sitk.ImageRegistrationMethod()\n",
    "    affine_reg.SetMetricAsMattesMutualInformation(numberOfHistogramBins=50)\n",
    "    affine_reg.SetOptimizerAsGradientDescent(learningRate=1.0, numberOfIterations=100)\n",
    "    affine_reg.SetInitialTransform(\n",
    "        sitk.CenteredTransformInitializer(fixed, moving, sitk.AffineTransform(fixed.GetDimension()), sitk.CenteredTransformInitializerFilter.GEOMETRY)\n",
    "    )\n",
    "    affine_reg.SetInterpolator(sitk.sitkLinear)\n",
    "\n",
    "    affine_transform = affine_reg.Execute(fixed, moving)\n",
    "\n",
    "    # Step 2: B-spline registration (local refinement)\n",
    "    grid_physical_spacing = [50.0, 50.0]  # B-spline mesh 간격 조정\n",
    "    image_physical_size = [size * spacing for size, spacing in zip(fixed.GetSize(), fixed.GetSpacing())]\n",
    "    mesh_size = [int(image_size/ps+0.5) for image_size, ps in zip(image_physical_size, grid_physical_spacing)]\n",
    "\n",
    "    bspline_transform = sitk.BSplineTransformInitializer(fixed, mesh_size)\n",
    "\n",
    "    bspline_reg = sitk.ImageRegistrationMethod()\n",
    "    bspline_reg.SetMetricAsMattesMutualInformation(numberOfHistogramBins=50)\n",
    "    bspline_reg.SetOptimizerAsLBFGSB(gradientConvergenceTolerance=1e-5, numberOfIterations=50)\n",
    "    bspline_reg.SetInitialTransform(bspline_transform, inPlace=False)\n",
    "    bspline_reg.SetMovingInitialTransform(affine_transform)\n",
    "    bspline_reg.SetInterpolator(sitk.sitkLinear)\n",
    "\n",
    "    final_transform = bspline_reg.Execute(fixed, moving)\n",
    "\n",
    "    return final_transform\n"
   ]
  },
