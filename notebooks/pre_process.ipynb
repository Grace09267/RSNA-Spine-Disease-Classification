   ],
   "source": [
    "# flow magnitude map이나 heatmap은 registration에서 어디에서 얼마나 많이 움직였는지를 정량적으로 시각화\n",
    "# => 즉, registration과정에서 \"변형이 많이 발생항 부위\"를 한눈에 확인 가능\n",
    "# Flow Magnitude Map(=Heatmap)\n",
    "def visualize_flow_magnitude(flow_tensor, title=\"Flow Magnitude (Displacement)\"):\n",
    "    flow_np = flow_tensor.squeeze().detach().cpu().numpy()  # (2, H, W)\n",
    "    u = flow_np[0]  # x 방향\n",
    "    v = flow_np[1]  # y 방향\n",
    "\n",
    "    magnitude = np.sqrt(u**2 + v**2)  # 픽셀 이동 거리\n",
    "\n",
    "    plt.figure(figsize=(6, 6))\n",
    "    plt.imshow(magnitude, cmap='jet')\n",
    "    plt.colorbar(label=\"Pixel Displacement\")\n",
    "    plt.title(title)\n",
    "    plt.axis('off')\n",
    "    plt.show()\n",
    "\n",
    "# 사용 예시\n",
    "visualize_flow_magnitude(flow)\n",
    "\n",
    "\n",
    "# 밝은/빨간 영역 => 변형이 많이 발생한 부분(픽셀 이동이 큼)\n",
    "# 어두운/파란 영역 => 거의 움직이지 않은 부분(정합 유지)\n",
    "# => 많이 움직인 영역이 label이 없는 쪽이며, label 전파 시 오차가 커질 수 있어 => 따라서, heatmap이 너무 밝은 부위엔 주의가 필요해"
   ]
  },
