    "# 기본 골격\n",
    "import cv2\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Anchor 이미지 (instance 8)\n",
    "anchor_img = anchor_slice\n",
    "\n",
    "# Target 이미지 (instance 9)\n",
    "target_img = target_slices[target_instance_number]\n",
    "\n",
    "\n",
    "# 0. (NEW) SIFT에 넣을 이미지 준비\n",
    "anchor_img_for_sift = cv2.normalize(anchor_img, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)\n",
    "target_img_for_sift = cv2.normalize(target_img, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)\n",
    "\n",
    "# 1. SIFT 특징점 추출\n",
    "sift = cv2.SIFT_create()\n",
    "\n",
    "# ★ 변환된 이미지 사용하기 ★\n",
    "kp1, des1 = sift.detectAndCompute(anchor_img_for_sift, None)\n",
    "kp2, des2 = sift.detectAndCompute(target_img_for_sift, None)\n",
    "\n",
    "# 2. 특징점 매칭 (BruteForce matcher + ratio test)\n",
    "bf = cv2.BFMatcher()\n",
    "matches = bf.knnMatch(des1, des2, k=2)\n",
    "\n",
    "good_matches = []\n",
    "for m, n in matches:\n",
    "    if m.distance < 0.75 * n.distance:\n",
    "        good_matches.append(m)\n",
    "\n",
    "print(f\"좋은 매칭 수: {len(good_matches)}개\")\n",
    "\n",
    "# 3. 매칭 포인트 배열 만들기\n",
    "src_pts = np.float32([ kp1[m.queryIdx].pt for m in good_matches ]).reshape(-1,1,2)\n",
    "dst_pts = np.float32([ kp2[m.trainIdx].pt for m in good_matches ]).reshape(-1,1,2)\n",
    "\n",
    "# 4. RANSAC을 이용해서 Affine Transform 찾기\n",
    "M, mask = cv2.estimateAffinePartial2D(src_pts, dst_pts, method=cv2.RANSAC)\n",
    "\n",
    "print(f\"Affine Transform:\\n{M}\")\n",
    "\n",
    "# 5. Anchor 좌표 이동 (anchor_labels)\n",
    "anchor_points = np.array(anchor_labels[['x', 'y']].values)\n",
    "\n",
    "# homogeneous 좌표로 변환 (Nx3)\n",
    "anchor_points_homo = np.concatenate([anchor_points, np.ones((anchor_points.shape[0],1))], axis=1)\n",
    "\n",
    "# 변환 적용\n",
    "target_points = (M @ anchor_points_homo.T).T\n",
    "\n",
    "# 6. 시각화\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 7))\n",
    "\n",
    "# Anchor 이미지\n",
    "ax1.imshow(anchor_img, cmap='gray')\n",
    "ax1.scatter(anchor_points[:,0], anchor_points[:,1], c='lime', label='Anchor Points')\n",
    "ax1.set_title(f\"Anchor (Instance {example_instance})\")\n",
    "ax1.legend()\n",
    "\n",
    "# Target 이미지\n",
    "ax2.imshow(target_img, cmap='gray')\n",
    "ax2.scatter(target_points[:,0], target_points[:,1], c='red', marker='x', label='Target Points')\n",
    "ax2.set_title(f\"Target (Instance {target_instance_number})\")\n",
    "ax2.legend()\n",
    "\n",
    "plt.show()\n"
   ]
