    "# 예시로 선택한 study를 DICOM 슬라이스 불러오기\n",
    "import pydicom\n",
    "\n",
    "def load_slices(study_id, series_id, base_path=\"rsna_2024_spine/train_images\"):\n",
    "    dcm_path = os.path.join(base_path, str(study_id), str(series_id))\n",
    "    files = os.listdir(dcm_path)\n",
    "    slices = []\n",
    "    for f in files:\n",
    "        dcm = pydicom.dcmread(os.path.join(dcm_path, f))\n",
    "        slices.append((dcm.InstanceNumber, f, dcm))\n",
    "    slices.sort(key=lambda x: x[0])\n",
    "    return slices\n",
    "\n",
    "# 사용 예시\n",
    "slices = load_slices(example_study, example_series)\n",
    "print(f\"불러온 슬라이스 수: {len(slices)}\")\n",
    "print(f\"첫 번째 슬라이스 InstanceNumber: {slices[0][0]}\")\n",
    "\n",
    "\n"
   ]
