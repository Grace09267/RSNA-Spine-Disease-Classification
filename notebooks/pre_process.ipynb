   "source": [
    "# 의료 영상 registration에서는 MSE 보다는 NCC(Normalized Cross-Correlation)을 더 자주씀.\n",
    "# intensity 분포가 다른 경우에 더 강력하고, T1 vs T2 혹은 노이즈/조명 차이에 더 강인\n",
    "# NCC(Normalized Cross Correlation) 손실 함수\n",
    "def ncc_loss(I, J, eps=1e-8):\n",
    "    \"\"\"\n",
    "    I, J: tensors of shape (B, 1, H, W)\n",
    "    Returns negative NCC (작을수록 좋음 → loss)\n",
    "    \"\"\"\n",
    "    I_mean = I.mean(dim=(2, 3), keepdim=True)\n",
    "    J_mean = J.mean(dim=(2, 3), keepdim=True)\n",
    "\n",
    "    I_centered = I - I_mean\n",
    "    J_centered = J - J_mean\n",
    "\n",
    "    numerator = (I_centered * J_centered).mean(dim=(2, 3), keepdim=True)\n",
    "    denominator = (I_centered.square().mean(dim=(2, 3), keepdim=True) * \n",
    "                   J_centered.square().mean(dim=(2, 3), keepdim=True)).sqrt() + eps\n",
    "\n",
    "    ncc = numerator / denominator\n",
    "    return -ncc.mean()  # loss로 쓰기 위해 음수 부호\n"
   ]
  },
