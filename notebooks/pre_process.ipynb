   "source": [
    "# 특정 좌표 주변만 확대하여 flow overlay 시각화\n",
    "# 예를 들어 L4/L5 라벨 좌표 기준으로 80x80 주변을 crop해서 확대 시각화 하는 코드\n",
    "def visualize_flow_overlay_crop(flow_tensor, anchor_image, center_coord, window_size=80, alpha=0.5, title=\"Local Flow Overlay\"):\n",
    "    \"\"\"\n",
    "    center_coord: (x, y) 중심 좌표\n",
    "    \"\"\"\n",
    "    x, y = int(center_coord[0]), int(center_coord[1])\n",
    "    half_w = window_size // 2\n",
    "\n",
    "    # 1. flow magnitude 계산\n",
    "    flow_np = flow_tensor.squeeze().detach().cpu().numpy()\n",
    "    u = flow_np[0]\n",
    "    v = flow_np[1]\n",
    "    magnitude = np.sqrt(u**2 + v**2)\n",
    "\n",
    "    # 2. anchor 정규화\n",
    "    anchor_norm = (anchor_image - anchor_image.min()) / (anchor_image.max() - anchor_image.min() + 1e-8)\n",
    "\n",
    "    # 3. crop 범위 설정\n",
    "    y_min, y_max = max(0, y - half_w), min(anchor_image.shape[0], y + half_w)\n",
    "    x_min, x_max = max(0, x - half_w), min(anchor_image.shape[1], x + half_w)\n",
    "\n",
    "    # 4. crop된 이미지/flow\n",
    "    anchor_crop = anchor_norm[y_min:y_max, x_min:x_max]\n",
    "    mag_crop = magnitude[y_min:y_max, x_min:x_max]\n",
    "\n",
    "    # 5. heatmap 생성\n",
    "    cmap = plt.get_cmap('jet')\n",
    "    heatmap = cmap(mag_crop / (mag_crop.max() + 1e-8))[:, :, :3]\n",
    "\n",
    "    # 6. overlay 생성\n",
    "    anchor_crop_rgb = np.repeat(anchor_crop[:, :, np.newaxis], 3, axis=2)\n",
    "    overlay = (1 - alpha) * anchor_crop_rgb + alpha * heatmap\n",
    "\n",
    "    plt.figure(figsize=(5, 5))\n",
    "    plt.imshow(overlay)\n",
    "    plt.title(title + f\" @ ({x}, {y})\")\n",
    "    plt.axis('off')\n",
    "    plt.show()\n"
   ]
