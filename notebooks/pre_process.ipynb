   "source": [
    "# 한 study에 시리즈가 여러개 있을 경우 가장 좋은 시퀀스를 우선 고를는 함수\n",
    "def select_series_per_study(desc_df, priority_sequences=[\"Sagittal T2/STIR\", \"Sagittal T2\"]):\n",
    "    selected = []\n",
    "    for study_id, group in desc_df.groupby(\"study_id\"):\n",
    "        for seq in priority_sequences:\n",
    "            match = group[group[\"series_description\"] == seq]\n",
    "            if not match.empty:\n",
    "                selected.append(match.iloc[0])\n",
    "                break  # 가장 우선순위 높은 시퀀스 하나만 선택\n",
    "    return pd.DataFrame(selected)\n",
    "\n",
    "# 적용\n",
    "selected_series_df = select_series_per_study(filtered_series_df)\n",
    "print(f\"최종 선택된 study 수: {selected_series_df['study_id'].nunique()}\")\n",
    "print(selected_series_df.head())\n"
   ]
