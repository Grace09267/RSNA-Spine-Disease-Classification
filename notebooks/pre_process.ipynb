    "# SimpleITK 의존 안하고 numpy로 MI를 직접 계산\n",
    "import numpy as np\n",
    "\n",
    "def calculate_mutual_information_histogram(img1, img2, bins=50):\n",
    "    \"\"\"\n",
    "    img1, img2: uint8 numpy arrays (grayscale)\n",
    "    bins: number of bins for the histogram\n",
    "    \"\"\"\n",
    "\n",
    "    # flatten\n",
    "    img1_flat = img1.flatten()\n",
    "    img2_flat = img2.flatten()\n",
    "\n",
    "    # joint histogram\n",
    "    hist_2d, x_edges, y_edges = np.histogram2d(img1_flat, img2_flat, bins=bins)\n",
    "\n",
    "    # joint probability\n",
    "    pxy = hist_2d / float(np.sum(hist_2d))\n",
    "\n",
    "    # marginal probabilities\n",
    "    px = np.sum(pxy, axis=1)  # sum over y\n",
    "    py = np.sum(pxy, axis=0)  # sum over x\n",
    "\n",
    "    # outer product\n",
    "    px_py = np.outer(px, py)\n",
    "\n",
    "    # avoid division by zero\n",
    "    non_zero = pxy > 0\n",
    "\n",
    "    # mutual information\n",
    "    mi = np.sum(pxy[non_zero] * np.log(pxy[non_zero] / px_py[non_zero]))\n",
    "\n",
    "    return mi\n"
   ]
  },
