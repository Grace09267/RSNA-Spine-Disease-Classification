    "# warp() 함수 정의(flow 적용 이미지 변형형)\n",
    "def warp(image, flow):\n",
    "    \"\"\"\n",
    "    image: (1, 1, H, W)\n",
    "    flow: (1, 2, H, W)\n",
    "    returns: warped image\n",
    "    \"\"\"\n",
    "    B, C, H, W = image.shape\n",
    "\n",
    "    # make normalized grid\n",
    "    grid_y, grid_x = torch.meshgrid(torch.arange(H), torch.arange(W), indexing='ij')\n",
    "    grid = torch.stack((grid_x, grid_y), 2).float().to(image.device)  # (H, W, 2)\n",
    "\n",
    "    grid = grid.unsqueeze(0)  # (1, H, W, 2)\n",
    "    grid = grid + flow.permute(0, 2, 3, 1)  # (1, H, W, 2)\n",
    "\n",
    "    # normalize to [-1, 1]\n",
    "    grid[..., 0] = (grid[..., 0] / (W - 1)) * 2 - 1\n",
    "    grid[..., 1] = (grid[..., 1] / (H - 1)) * 2 - 1\n",
    "\n",
    "    warped = F.grid_sample(image, grid, mode='bilinear', padding_mode='border', align_corners=True)\n",
    "    return warped"
   ]
  },
