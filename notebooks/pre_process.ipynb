   "source": [
    "# Flow Vector 시각화 (Quiver Plot)\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def visualize_flow_quiver(flow_tensor, step=20, title=\"Flow Field\"):\n",
    "    \"\"\"\n",
    "    flow_tensor: torch tensor (1, 2, H, W)\n",
    "    step: 간격 (너무 촘촘하면 보기 어려우니까)\n",
    "    \"\"\"\n",
    "    flow_np = flow_tensor.squeeze().detach().cpu().numpy()  # (2, H, W)\n",
    "    u = flow_np[0]  # x방향 (좌우)\n",
    "    v = flow_np[1]  # y방향 (상하)\n",
    "    H, W = u.shape\n",
    "\n",
    "    # 좌표 그리드 생성\n",
    "    x = np.arange(0, W, step)\n",
    "    y = np.arange(0, H, step)\n",
    "    X, Y = np.meshgrid(x, y)\n",
    "\n",
    "    # 선택된 위치의 flow만 추출\n",
    "    U = u[::step, ::step]\n",
    "    V = v[::step, ::step]\n",
    "\n",
    "    plt.figure(figsize=(6, 6))\n",
    "    plt.imshow(anchor_img_np, cmap='gray')\n",
    "    plt.quiver(X, Y, U, V, color='lime', angles='xy', scale_units='xy', scale=1)\n",
    "    plt.title(title)\n",
    "    plt.axis('off')\n",
    "    plt.show()\n",
    "\n",
    "# 사용 예시\n",
    "visualize_flow_quiver(flow, step=20, title=\"Flow Field (Anchor to Target)\")\n",
    "\n",
    "'''\n",
    "화살표 방향 - 각 위치의 픽셀이 이동항 방향\n",
    "화살표 길이 - 이동한 거리(flow magnitude)\n",
    "anchor 이미지 위 - 어떤 구조가 얼마나 변형되었는지 시각적으로 이해 가능\n",
    "'''\n"
   ]
